rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: 닉네임, 캐릭터, 친구코드, 스탬프 수를 담은 공개 프로필.
    // 친구 코드로 검색해야 하므로 로그인한 사용자는 서로 읽을 수 있어야 한다.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.friendCode == resource.data.friendCode; // 발급된 친구코드는 변경 불가
      allow delete: if false;
    }

    // friendships/{uidA_uidB}: 문서 ID가 정렬된 두 uid 조합이어야만 생성 가능.
    match /friendships/{friendshipId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() == 2
        && friendshipId == (
             request.resource.data.uids[0] < request.resource.data.uids[1]
               ? request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
               : request.resource.data.uids[1] + '_' + request.resource.data.uids[0]
           );
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    // parties/{partyId}: members는 배열-of-맵이라 규칙에서 uid만 직접 조회할 수 없으므로
    // 검증용으로 병행 관리하는 memberUids 배열을 기준으로 접근을 제어한다.
    match /parties/{partyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.memberUids
            || request.auth.uid in request.resource.data.memberUids);
      allow delete: if request.auth != null && request.auth.uid in resource.data.memberUids;
    }
  }
}
